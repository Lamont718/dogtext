DATABASE_URL="postgresql://user:password@host:5432/dbname?connect_timeout=15"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AWS S3 for celebration photo uploads
AWS_PROFILE=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=

# AbacusAI route key (for /api/chat and /api/generate-dog-messages)
ABACUSAI_API_KEY=

# Comma-separated list of admin emails (case-insensitive). Admins can approve/reject celebrations.
ADMIN_EMAILS=
