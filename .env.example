# Postgres connection string. Provision a fresh DB (Neon / Supabase / Railway).
# Then run: npx prisma db push  to create all tables including daily_barks.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth — generate a fresh one with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Photo uploads for celebrations. Any S3-compatible bucket (AWS S3, Cloudflare R2,
# Backblaze B2). Leave blank in v1 if you're not enabling celebration uploads.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=

# OpenAI — used by /api/chat, /api/generate-dog-messages (homepage demo),
# and /api/daily-bark/[dogId] (daily bark generation).
OPENAI_API_KEY=

# Comma-separated list of admin emails (case-insensitive). Admins can
# approve/reject celebration submissions at /admin/celebrations.
ADMIN_EMAILS=

# --- Daily Bark email delivery (the product's core promise) ---
# Resend API key (https://resend.com — free tier covers pre-launch traffic).
RESEND_API_KEY=
# "Name <address@domain>" used as From. Domain must be verified in Resend
# OR use Resend's onboarding sandbox: "DogText <onboarding@resend.dev>".
EMAIL_FROM=DogText <hello@dogtext.app>
# Random secret. Generate with: openssl rand -hex 32
# Vercel Cron automatically sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Set to "1" to actually send emails. Leave blank/0 for staging and previews
# so deploys don't accidentally mail every user.
EMAIL_DELIVERY_ENABLED=
