# Postgres connection string. Provision a fresh DB (Neon / Supabase / Railway).
# Then run: npx prisma db push  to create all tables including daily_barks.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth — generate a fresh one with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Photo uploads for celebrations. Any S3-compatible bucket (AWS S3, Cloudflare R2,
# Backblaze B2). Leave blank in v1 if you're not enabling celebration uploads.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=

# OpenAI — used by /api/chat, /api/generate-dog-messages (homepage demo),
# and /api/daily-bark/[dogId] (daily bark generation).
OPENAI_API_KEY=

# Comma-separated list of admin emails (case-insensitive). Admins can
# approve/reject celebration submissions at /admin/celebrations.
ADMIN_EMAILS=
