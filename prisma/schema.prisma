generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String    @id @default(cuid())
  firstName         String?
  lastName          String?
  email             String    @unique
  emailVerified     DateTime?
  password          String?
  image             String?
  subscriptionTier  String    @default("FREE") // FREE, PREMIUM, FAMILY
  subscriptionId    String?
  // The paid-plan waitlist: set when someone joins the list for PREMIUM or
  // FAMILY. The people to email, at their launch price, when billing opens.
  interestedPlan    String?
  interestedAt      DateTime?
  // Where they signed up from: demo (homepage demo), plan (pricing list), direct.
  signupSource      String?
  // Reserved a printed book of the dog's letters (printing not open yet).
  bookReservedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  accounts         Account[]
  sessions         Session[]
  dogs             Dog[]
  aiChatMessages   AiChatMessage[]
  messageUsage     MessageUsage[]
  bookmarks        UserBookmark[]
  settings         UserSettings?
  celebrations     Celebration[]
  dailyBarks       DailyBark[]
  pushSubscriptions PushSubscription[]
  kids             Kid[]
  bookOrders       BookOrder[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Core application models
model Dog {
  id                 String   @id @default(cuid())
  userId             String
  name               String
  breed              String
  age                Int?
  ageUnit            String?  // months, years
  weight             Float?
  weightUnit         String?  // lbs, kg
  gender             String?  // male, female
  personalityTraits  String[] // playful, calm, energetic, etc.
  healthConditions   String[] // any known health issues
  photoUrl           String?
  cloudStoragePath   String?  // S3 key for photo
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiChatMessages AiChatMessage[]
  dailyBarks     DailyBark[]
  photo          DogPhoto?

  @@map("dogs")
}

// The dog's photo, kept in the database: the browser shrinks it to a small
// JPEG square (~50KB) before upload, so no file-storage service is needed.
// Served at /api/dogs/[id]/photo; Dog.photoUrl points there.
model DogPhoto {
  id          String   @id @default(cuid())
  dogId       String   @unique
  data        Bytes
  contentType String   @default("image/jpeg")
  updatedAt   DateTime @updatedAt

  dog Dog @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@map("dog_photos")
}

model BreedProfile {
  id                   String   @id @default(cuid())
  breedName            String   @unique
  slug                 String   @unique
  description          String   @db.Text
  origin               String   @db.Text
  physicalCharacteristics String @db.Text
  temperament          String   @db.Text
  exerciseNeeds        String   @db.Text
  groomingRequirements String   @db.Text
  healthConsiderations String   @db.Text
  trainingTips         String   @db.Text
  idealLivingConditions String  @db.Text
  imageUrl             String?
  imageAlt             String?
  sizeCategory         String?  // toy, small, medium, large, giant
  energyLevel          String?  // low, moderate, high
  groomingLevel        String?  // low, moderate, high
  trainability         String?  // easy, moderate, challenging
  familyFriendly       Boolean  @default(true)
  goodWithKids         Boolean  @default(true)
  goodWithPets         Boolean  @default(true)
  isPopular            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("breed_profiles")
}

model Article {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  content       String    @db.Text
  excerpt       String?   @db.Text
  category      String    // training, health, nutrition, puppy-care, senior-care
  readTime      Int       // estimated reading time in minutes
  author        String    @default("DogText Expert Team")
  imageUrl      String?
  imageAlt      String?
  tags          String[]  // for filtering and search
  isPublished   Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  viewCount     Int       @default(0)
  publishedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  bookmarks UserBookmark[]

  @@map("articles")
}

model AiChatMessage {
  id          String   @id @default(cuid())
  userId      String
  dogId       String
  messageText String   @db.Text
  senderType  String   // user, ai
  metadata    Json?    // store breed context, personality context, etc.
  createdAt   DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dog  Dog  @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@map("ai_chat_messages")
  @@index([userId, dogId, createdAt])
}

model MessageUsage {
  id           String   @id @default(cuid())
  userId       String
  weekStartDate DateTime // start of the week (Monday)
  messageCount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStartDate], name: "userId_weekStartDate")
  @@map("message_usage")
}

model UserBookmark {
  id          String   @id @default(cuid())
  userId      String
  contentType String   // article, breed_profile
  contentId   String
  createdAt   DateTime @default(now())

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, contentId])
  @@map("user_bookmarks")
}

model UserSettings {
  id                    String  @id @default(cuid())
  userId                String  @unique
  emailNotifications    Boolean @default(true)
  marketingEmails       Boolean @default(false)
  weeklyDigest          Boolean @default(true)
  chatPersonality       String  @default("friendly") // friendly, professional, playful
  preferredUnits        String  @default("imperial") // imperial, metric
  timezone              String  @default("America/New_York")
  language              String  @default("en")
  themePreference       String  @default("system") // light, dark, system
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// Daily Bark — one short morning message from each dog, generated lazily and shareable.
// The retention loop: a reason to open the app every morning even when nothing's wrong.
model DailyBark {
  id            String    @id @default(cuid())
  userId        String
  dogId         String
  generatedFor  DateTime  @db.Date  // YYYY-MM-DD UTC, the "day" this bark belongs to
  messageText   String    @db.Text
  viewedAt      DateTime?
  emailedAt     DateTime?
  pushedAt      DateTime? // sent as a phone notification (lib/push.ts)
  shareCount    Int       @default(0)
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dog  Dog  @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@unique([dogId, generatedFor], name: "dogId_generatedFor")
  @@index([userId, generatedFor])
  @@map("daily_barks")
}

model Celebration {
  id               String   @id @default(cuid())
  userId           String
  dogId            String
  dogName          String   // denormalized for display
  dogBreed         String   // denormalized for display
  milestoneType    String   // birthday, adoption_anniversary, gotcha_day, training_achievement, health_milestone
  photoUrl         String   // /api/celebrations/[id]/photo (photo kept in CelebrationPhoto)
  cloudStoragePath String?  // legacy S3 key; unused since photos moved to the database
  caption          String   // max 100 characters
  milestoneDate    DateTime // the date of the milestone
  status           String   @default("pending") // pending, approved, rejected
  rejectionReason  String?  // reason for rejection if rejected
  submittedAt      DateTime @default(now())
  reviewedAt       DateTime?
  reviewedBy       String?  // admin user ID who reviewed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo CelebrationPhoto?

  @@map("celebrations")
  @@index([status, submittedAt])
  @@index([milestoneType, status])
}

// A celebration's photo, shrunk in the browser (max 1080px JPEG) and kept in
// the database like DogPhoto. Public only once the celebration is approved.
model CelebrationPhoto {
  id            String   @id @default(cuid())
  celebrationId String   @unique
  data          Bytes
  contentType   String   @default("image/jpeg")
  createdAt     DateTime @default(now())

  celebration Celebration @relation(fields: [celebrationId], references: [id], onDelete: Cascade)

  @@map("celebration_photos")
}

// A phone or browser that gets the morning text as a notification (Web Push).
// One row per device; a dead endpoint (404/410 from the push service) is deleted.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// One row per homepage demo run: how many people try it, and which breeds.
// No names or other personal details are kept.
model DemoRun {
  id        String   @id @default(cuid())
  breed     String
  fromBreedPage Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("demo_runs")
}

// A homepage-demo text someone chose to share (they tapped Share). Public at
// /t/[id]. Only texts the demo actually generated can be saved (signed in
// /api/generate-dog-messages, checked in /api/share-text).
model SharedText {
  id        String   @id @default(cuid())
  dogName   String
  breed     String   // display name
  message   String   @db.Text
  views     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("shared_texts")
}

// A child the family dog writes to. Parents enter first names (and an
// optional age for reading level) themselves; nothing is collected from the
// children, and no photos of them.
model Kid {
  id        String   @id @default(cuid())
  userId    String
  firstName String
  age       Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("kids")
}

// A paid printed book (Stripe Checkout on the shared Our Rose account, tagged
// metadata.brand = dogtext). Packed by hand: Lamont downloads the Mixam files
// from /admin and orders it shipped to this address.
model BookOrder {
  id              String    @id @default(cuid())
  userId          String
  stripeSessionId String    @unique
  amountTotal     Int       // cents, book + shipping
  letterCount     Int       // letters in the book when ordered (its first N letters)
  shipName        String?
  shipAddress     Json?
  email           String?
  status          String    @default("paid") // paid, sent_to_mixam, shipped
  createdAt       DateTime  @default(now())
  sentToMixamAt   DateTime?
  shippedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("book_orders")
}
